<#@ template debug="false" hostspecific="false" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ output extension=".cs" #>
<#@ include file="..\T4\Constants.tt" #>
using ExRam.Gremlinq.Core.Steps;

namespace ExRam.Gremlinq.Core
{
<# for(var i = 0; i <= 16; i++) { #>
    public interface ITreeBuilder<#= GetGenericArgumentList("TNode{0}", i) #>
<# if (i >= 1) { #>
        : ITreeBuilderResult<<#= GetTreeTypeName(i) #>>
<# } #>
<# for(var j = 1; j <= i; j++) { #>
            where TNode<#= j  #> : notnull
<# } #>
    {
<# if (i < 16) { #>
        ITreeBuilder<<#= GetArgumentList("TNode{0}", i, false, true)#>TNewNode> Of<TNewNode>() where TNewNode : notnull;

        ITreeBuilder<<#= GetArgumentList("TNode{0}", i, false, true)#>TNewNode> Of<TNewNode>(Func<ITreeNodeBuilder<TNewNode>, ITreeNodeBuilder<TNewNode>> nodeBuilderTransformation) where TNewNode : notnull;
<# } #>
    }

<# } #>

    partial class GremlinQuery<T1, T2, T3, T4>
    {
        private sealed partial class TreeBuilder<TNode1, TNode2, TNode3, TNode4, TNode5, TNode6, TNode7, TNode8, TNode9, TNode10, TNode11, TNode12, TNode13, TNode14, TNode15, TNode16> :
<# for(var i = 1; i <= 16; i++) { #>
            ITreeBuilder<<#= GetArgumentList("TNode{0}", i) #>>,
<# } #>
            ITreeBuilder
<# for(var i = 1; i <= 16; i++) { #>
                where TNode<#= i  #> : notnull
<# } #>
        {
<# for(var i = 0; i < 16; i++) { #>
            ITreeBuilder<<#= GetArgumentList("TNode{0}", i, false, true) #>TNewNode> ITreeBuilder<#= GetGenericArgumentList("TNode{0}", i) #>.Of<TNewNode>()
            {
                return new TreeBuilder<<#= GetArgumentList("TNode{0}", i, false, true) #>TNewNode<#= GetArgumentList("object", 15 - i, true)#>>(_sourceQuery, _bySteps.Add(TreeStep.ByIdentityStep.Instance));
            }

            ITreeBuilder<<#= GetArgumentList("TNode{0}", i, false, true) #> TNewNode> ITreeBuilder<#= GetGenericArgumentList("TNode{0}", i) #>.Of<TNewNode>(Func<ITreeNodeBuilder<TNewNode>, ITreeNodeBuilder<TNewNode>> nodeBuilderTransformation)
            {
                if (nodeBuilderTransformation(TreeNodeBuilder<TNewNode>.Identity) is TreeNodeBuilder<TNewNode> projectedNodeBuilder)
                    return new TreeBuilder<<#= GetArgumentList("TNode{0}", i, false, true) #>TNewNode<#= GetArgumentList("object", 15 - i, true)#>>(_sourceQuery, _bySteps.Add(projectedNodeBuilder.Build(_sourceQuery)));

                throw new InvalidOperationException();
            }

<# } #>

<# for(var i = 1; i <= 16; i++) { #>

            IGremlinQuery<<#= GetTreeTypeName(i) #>> ITreeBuilderResult<<#= GetTreeTypeName(i) #>>.Build() => Build<<#= GetTreeTypeName(i) #>>();
<# } #>
        }
    }
}


FROM tinkerpop/gremlin-server:3.7.5

RUN echo >> /opt/gremlin-server/conf/tinkergraph-empty.properties
RUN echo "gremlin.tinkergraph.vertexIdManager=STRING" >> /opt/gremlin-server/conf/tinkergraph-empty.properties
RUN echo "gremlin.tinkergraph.edgeIdManager=STRING" >> /opt/gremlin-server/conf/tinkergraph-empty.properties
RUN echo "gremlin.tinkergraph.vertexPropertyIdManager=STRING"  >> /opt/gremlin-server/conf/tinkergraph-empty.properties
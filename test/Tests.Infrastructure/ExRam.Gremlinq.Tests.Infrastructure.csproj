<Project Sdk="Microsoft.NET.Sdk">

  <!-- On CI, IntegrationTestAttribute lets integration tests run on the last of the target frameworks only. -->
  <PropertyGroup>
    <LatestTargetFramework>$(TargetFrameworks.Substring($([MSBuild]::Add($(TargetFrameworks.LastIndexOf(';')), 1))).Trim())</LatestTargetFramework>
    <DefineConstants Condition="'$(TargetFramework)' == '$(LatestTargetFramework)'">LATEST_TARGET_FRAMEWORK;$(DefineConstants)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Core/ExRam.Gremlinq.Core.csproj" />
    <ProjectReference Include="../../src/Providers.Core/ExRam.Gremlinq.Providers.Core.csproj" />

    <ProjectReference Include="../Tests.Entities/ExRam.Gremlinq.Tests.Entities.csproj" />

    <PackageReference Include="System.Interactive.Async" />
  </ItemGroup>

</Project>

{
  "$schema": "http://json.schemastore.org/template",
  "author": "Daniel Weber",
  "classifications": [ "Common", "Console" ],
  "identity": "ExRam.Gremlinq.Templates.Console",
  "name": "Gremlinq console app template",
  "shortName": "gremlinq-console",
  "sourceName": "ExRam.Gremlinq.Templates.Console",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "provider": {
      "type": "parameter",
      "isRequired": true,
      "datatype": "choice",
      "defaultValue": "GremlinServerContainer",
      "choices": [
        {
          "choice": "GremlinServerContainer",
          "description": "Modded Gremlin Server in a local Docker container."
        },
        {
          "choice": "GremlinServer",
          "description": "Gremlin Server"
        },
        {
          "choice": "Neptune",
          "description": "AWS Neptune"
        },
        {
          "choice": "CosmosDb",
          "description": "Azure CosmosDb"
        },
        {
          "choice": "JanusGraph",
          "description": "JanusGraph"
        }
      ]
    },
    "actualProvider": {
      "type": "generated",
      "generator": "switch",
      "replaces": "TEMPLATEPROVIDER",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          {
            "condition": "(provider == 'GremlinServer' || provider == 'GremlinServerContainer')",
            "value": "GremlinServer"
          },
          {
            "condition": "(provider == 'CosmosDb')",
            "value": "CosmosDb"
          },
          {
            "condition": "(provider == 'Neptune')",
            "value": "Neptune"
          },
          {
            "condition": "(provider == 'JanusGraph')",
            "value": "JanusGraph"
          }
        ]
      }
    },
    "version": {
      "description": "The version of ExRam.Gremlinq being referenced",
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "TEMPLATE_GREMLINQ_VERSION_DEFAULT_VALUE",
      "replaces": "TEMPLATE_GREMLINQ_VERSION"
    }
  }
}